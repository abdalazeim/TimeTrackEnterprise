<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <ImageButton
                android:id="@+id/btnBack"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/text"
                android:contentDescription="@string/back"
                android:layout_marginStart="6dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                style="@style/TextTitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <FrameLayout
                android:background="@drawable/bg_icon_tile"
                android:padding="15dp"
                android:layout_width="64dp"
                android:layout_height="64dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_barcode"
                    android:tint="@color/primary"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:fontFamily="@font/cairo"/>
            <TextView
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/about_subtitle"
                style="@style/TextBody"/>
            <TextView
                android:id="@+id/versionChip"
                android:background="@drawable/bg_chip"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="@style/TextLabel"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_app_title"
                style="@style/TextSection"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_app_body"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_author_title"
                style="@style/TextSection"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false">
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="@string/avatar_letters"
                    android:fontFamily="@font/cairo"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/author_name"
                        android:fontFamily="@font/cairo"/>
                    <TextView
                        android:id="@+id/authorLatin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/author_latin"
                        android:textDirection="ltr"
                        style="@style/TextBody"/>
                    <TextView
                        android:textColor="@color/primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/author_handle"
                        android:textDirection="ltr"
                        style="@style/TextBody"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_location"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/author_location"
                style="@style/TextBody"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/author_work"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card_soft"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_dedication_title"
                style="@style/TextSection"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/about_dedication_text"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/cairo"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/about_dedication_note"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_info_title"
                style="@style/TextSection"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/info_version"
                style="@style/TextLabel"/>
            <TextView
                android:id="@+id/versionValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_package"
                style="@style/TextLabel"/>
            <TextView
                android:textColor="@color/text_muted"
                android:id="@+id/packageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                style="@style/TextMono"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_android"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_android_value"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_languages"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_languages_value"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_api"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_api_value"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_port"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_port_value"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_mode"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_mode_value"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info_compat"
                style="@style/TextLabel"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_compat_value"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/primary"
                    android:contentDescription="@null"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/about_privacy_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/TextSection"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_privacy_body"
                style="@style/TextBody"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_license"
                style="@style/TextBody"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/about_repo_button"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_globe"
            android:drawableTint="@color/text_muted"
            style="@style/BtnSecondary"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_faint"
            android:gravity="center"
            android:id="@+id/copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/TextBody"/>
    </LinearLayout>
</ScrollView>
