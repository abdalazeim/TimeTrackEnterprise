<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_muted"
            android:contentDescription="@string/back"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/companion_title"
                android:fontFamily="@font/cairo"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:id="@+id/headerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/companion_subtitle"
                android:fontFamily="@font/cairo"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnLogout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/companion_logout"
            style="@style/BtnSmall"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/loginScroll"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_login_title"
                        style="@style/TextSection"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/companion_login_body"
                        style="@style/TextBody"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/loginModeRow"
                        android:background="@drawable/bg_card_soft"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <Button
                            android:textSize="12sp"
                            android:id="@+id/btnModePasscode"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:text="@string/companion_mode_passcode"
                            android:layout_weight="1"
                            style="@style/BtnPrimary"/>
                        <Button
                            android:textSize="12sp"
                            android:id="@+id/btnModeAccount"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:text="@string/companion_mode_account"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            style="@style/BtnSecondary"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/companion_server"
                        style="@style/TextLabel"/>
                    <EditText
                        android:id="@+id/serverInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/companion_server_hint"
                        android:maxLength="200"
                        android:inputType="textUri"
                        android:textDirection="ltr"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/accountFields"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/companion_username"
                            style="@style/TextLabel"/>
                        <EditText
                            android:id="@+id/userInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLength="64"
                            android:inputType="text"
                            android:textDirection="ltr"
                            android:autofillHints="username"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/companion_password"
                            style="@style/TextLabel"/>
                        <EditText
                            android:id="@+id/passwordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLength="128"
                            android:inputType="textPassword"
                            android:autofillHints="current-password"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/passcodeFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/companion_passcode"
                            style="@style/TextLabel"/>
                        <EditText
                            android:textSize="18sp"
                            android:id="@+id/passcodeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:hint="@string/companion_passcode_hint_input"
                            android:maxLength="8"
                            android:digits="0123456789"
                            android:inputType="number"
                            android:textDirection="ltr"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/text_faint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/companion_passcode_help"
                            style="@style/TextBody"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/companion_connect"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_shield"
                        android:drawableTint="@color/primary_contrast"
                        style="@style/BtnPrimary"/>
                    <TextView
                        android:id="@+id/loginStatus"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/TextBody"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_soft"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_howto_title"
                        style="@style/TextLabel"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/companion_howto_1"
                        style="@style/TextBody"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/companion_howto_2"
                        style="@style/TextBody"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/companion_howto_3"
                        style="@style/TextBody"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_faint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/companion_howto_note"
                        style="@style/TextBody"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView
            android:id="@+id/pairingScroll"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_pairing_title"
                        style="@style/TextSection"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/companion_pairing_body"
                        style="@style/TextBody"/>
                    <TextView
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="center"
                        android:id="@+id/pairingCode"
                        android:background="@drawable/bg_card_soft"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="----"
                        android:fontFamily="@font/cairo"
                        android:textDirection="ltr"
                        android:letterSpacing="0.25"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/pairingDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="@style/TextLabel"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/pairingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/companion_pairing_waiting"
                        style="@style/TextBody"/>
                    <Button
                        android:id="@+id/btnPairingRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/companion_pairing_check"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_shield"
                        android:drawableTint="@color/primary_contrast"
                        style="@style/BtnPrimary"/>
                    <Button
                        android:id="@+id/btnPairingLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/companion_pairing_cancel"
                        style="@style/BtnSecondary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_soft"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_pairing_help_title"
                        style="@style/TextLabel"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/companion_pairing_help_1"
                        style="@style/TextBody"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/companion_pairing_help_2"
                        style="@style/TextBody"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_faint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/companion_pairing_help_3"
                        style="@style/TextBody"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/appPanel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <Button
                    android:id="@+id/btnPrevDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_prev_day"
                    style="@style/BtnSmall"/>
                <TextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/dateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    style="@style/TextSection"/>
                <Button
                    android:id="@+id/btnNextDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_next_day"
                    style="@style/BtnSmall"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <Button
                    android:id="@+id/btnToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_today"
                    android:layout_marginEnd="8dp"
                    style="@style/BtnSmall"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/success"
                    android:id="@+id/connectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextBody"/>
                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_refresh"
                    style="@style/BtnSmall"/>
            </LinearLayout>
            <HorizontalScrollView
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tabBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Button
                        android:textColor="@color/primary_contrast"
                        android:id="@+id/tabOverview"
                        android:background="@drawable/bg_button_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_overview"
                        android:layout_marginEnd="6dp"
                        style="@style/BtnSmall"/>
                    <Button
                        android:textColor="@color/text_muted"
                        android:id="@+id/tabAbsences"
                        android:background="@drawable/bg_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_absences"
                        android:layout_marginEnd="6dp"
                        style="@style/BtnSmall"/>
                    <Button
                        android:textColor="@color/text_muted"
                        android:id="@+id/tabStudents"
                        android:background="@drawable/bg_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_students"
                        android:layout_marginEnd="6dp"
                        style="@style/BtnSmall"/>
                    <Button
                        android:textColor="@color/text_muted"
                        android:id="@+id/tabAttendance"
                        android:background="@drawable/bg_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_attendance"
                        android:layout_marginEnd="6dp"
                        style="@style/BtnSmall"/>
                    <Button
                        android:textColor="@color/text_muted"
                        android:id="@+id/tabStaff"
                        android:background="@drawable/bg_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_staff"
                        android:layout_marginEnd="6dp"
                        style="@style/BtnSmall"/>
                    <Button
                        android:textColor="@color/text_muted"
                        android:id="@+id/tabReport"
                        android:background="@drawable/bg_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/companion_tab_report"
                        style="@style/BtnSmall"/>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/filterBar"
                android:paddingTop="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/companion_search_hint"
                    android:maxLines="1"
                    android:maxLength="80"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <Spinner
                        android:id="@+id/classSpinner"
                        android:background="@drawable/bg_input"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                    <Spinner
                        android:id="@+id/statusSpinner"
                        android:background="@drawable/bg_input"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="6dp"/>
                    <Button
                        android:id="@+id/btnApplyFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/companion_apply"
                        android:layout_marginStart="6dp"
                        style="@style/BtnSmall"/>
                </LinearLayout>
            </LinearLayout>
            <ScrollView
                android:id="@+id/contentScroll"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/content"
                    android:paddingTop="10dp"
                    android:paddingBottom="30dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"/>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
