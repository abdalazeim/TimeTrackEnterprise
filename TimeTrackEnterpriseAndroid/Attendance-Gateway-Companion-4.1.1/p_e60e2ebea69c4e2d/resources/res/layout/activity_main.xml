<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <FrameLayout
                android:background="@drawable/bg_icon_tile"
                android:padding="11dp"
                android:layout_width="46dp"
                android:layout_height="46dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_barcode"
                    android:tint="@color/primary"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:fontFamily="@font/cairo"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/app_subtitle"
                    android:fontFamily="@font/cairo"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnLanguage"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_globe"
                android:tint="@color/text_muted"
                android:contentDescription="@string/language"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <View
                    android:id="@+id/statusDot"
                    android:background="@drawable/bg_dot_off"
                    android:layout_width="10dp"
                    android:layout_height="10dp"/>
                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/TextSection"/>
                <TextView
                    android:id="@+id/portChip"
                    android:background="@drawable/bg_chip"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    style="@style/TextLabel"/>
            </LinearLayout>
            <TextView
                android:id="@+id/statusHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_stopped_hint"
                style="@style/TextBody"/>
            <TextView
                android:id="@+id/statusStats"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/TextLabel"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">
                <View
                    android:id="@+id/pcDot"
                    android:background="@drawable/bg_dot_off"
                    android:layout_width="8dp"
                    android:layout_height="8dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:id="@+id/pcStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_never_format"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/TextBody"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/danger"
                android:id="@+id/statusLastError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/TextBody"/>
            <View
                android:background="@color/border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_endpoint"
                style="@style/TextLabel"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false">
                <TextView
                    android:id="@+id/endpoint"
                    android:background="@drawable/bg_key_box"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    style="@style/TextMono"/>
                <ImageButton
                    android:id="@+id/btnCopyEndpoint"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/primary"
                    android:contentDescription="@string/copy"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_pair_pin"
                style="@style/TextLabel"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:id="@+id/pairPin"
                    android:background="@drawable/bg_key_box"
                    android:padding="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textDirection="ltr"
                    android:letterSpacing="0.35"
                    style="@style/TextMono"/>
                <ImageButton
                    android:id="@+id/btnCopyPin"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/primary"
                    android:contentDescription="@string/copy"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pair_pin_hint"
                style="@style/TextBody"/>
            <Button
                android:id="@+id/btnRegenerate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_new_pin"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_refresh"
                android:drawableTint="@color/text_muted"
                style="@style/BtnSmall"/>
            <Button
                android:id="@+id/btnToggleServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/btn_start"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_play"
                android:drawableTint="@color/primary_contrast"
                style="@style/BtnPrimary"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/permissionBox"
                android:background="@drawable/bg_card_soft"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_missing_title"
                    android:fontFamily="@font/cairo"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/permission_missing_body"
                    style="@style/TextBody"/>
                <Button
                    android:id="@+id/btnGrantSms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_grant_sms"
                    style="@style/BtnSmall"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/note_keep_phone"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/bg_icon_tile"
                    android:padding="8dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_barcode"
                    android:tint="@color/primary"
                    android:contentDescription="@string/phone_scanner_title"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_scanner_title"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TextSection"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/phone_scanner_body"
                style="@style/TextBody"/>
            <TextView
                android:textColor="@color/text_muted"
                android:id="@+id/scannerCardStatus"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/TextLabel"/>
            <Button
                android:id="@+id/btnOpenScanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/phone_scanner_open"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_barcode"
                android:drawableTint="@color/primary_contrast"
                style="@style/BtnPrimary"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/phone_scanner_hint"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/bg_icon_tile"
                    android:padding="8dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/primary"
                    android:contentDescription="@string/companion_card_title"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_card_title"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    style="@style/TextSection"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/companion_card_body"
                style="@style/TextBody"/>
            <TextView
                android:textColor="@color/text_muted"
                android:id="@+id/companionStatus"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/TextLabel"/>
            <Button
                android:id="@+id/btnCompanion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/companion_open"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_info"
                android:drawableTint="@color/primary_contrast"
                style="@style/BtnPrimary"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/howto_title"
                style="@style/TextSection"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/howto_step_1"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/howto_step_2"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/howto_step_3"
                style="@style/TextBody"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/howto_note"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                style="@style/TextSection"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_port"
                style="@style/TextLabel"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false">
                <EditText
                    android:id="@+id/portInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="8080"
                    android:hint="@string/info_port_value"
                    android:maxLength="5"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:textDirection="ltr"/>
                <Button
                    android:id="@+id/btnSavePort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_save_restart"
                    android:layout_marginStart="8dp"
                    style="@style/BtnSecondary"/>
            </LinearLayout>
            <View
                android:background="@color/border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_battery"
                    android:tint="@color/warning"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_title"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/TextSection"/>
            </LinearLayout>
            <TextView
                android:id="@+id/batteryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="@style/TextBody"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/battery_hint"
                style="@style/TextBody"/>
            <Button
                android:id="@+id/btnBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_battery"
                style="@style/BtnSecondary"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_title"
                style="@style/TextSection"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/test_desc"
                style="@style/TextBody"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_phone"
                style="@style/TextLabel"/>
            <EditText
                android:id="@+id/testPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/phone_hint"
                android:maxLength="20"
                android:inputType="phone"
                android:textDirection="ltr"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_message"
                style="@style/TextLabel"/>
            <EditText
                android:gravity="start|top"
                android:id="@+id/testMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/test_default_message"
                android:minLines="3"
                android:maxLength="500"
                android:inputType="textMultiLine"/>
            <Button
                android:id="@+id/btnSendTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_send_test"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="@color/primary_contrast"
                style="@style/BtnPrimary"/>
            <TextView
                android:id="@+id/testResult"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/TextBody"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/log_title"
                    android:layout_weight="1"
                    style="@style/TextSection"/>
                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_clear"
                    style="@style/BtnSmall"/>
            </LinearLayout>
            <TextView
                android:id="@+id/logEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/log_empty"
                style="@style/TextBody"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/logContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_info"
            android:drawableTint="@color/text_muted"
            style="@style/BtnSecondary"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_faint"
            android:gravity="center"
            android:id="@+id/versionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            style="@style/TextBody"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_faint"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/author_name"
            style="@style/TextBody"/>
    </LinearLayout>
</ScrollView>
