<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/scannerPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/scanner_scrim_soft"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageButton
                android:id="@+id/btnScannerBack"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/text"
                android:contentDescription="@string/back"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:id="@+id/scannerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/scanner_title"
                android:layout_weight="1"
                android:fontFamily="@font/cairo"/>
            <ImageButton
                android:id="@+id/btnTorch"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_flash"
                android:tint="@color/text_muted"
                android:contentDescription="@string/scanner_torch"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <View
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_frame"
                android:layout_width="280dp"
                android:layout_height="170dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/scannerHint"
                android:background="@color/scanner_scrim_soft"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/scanner_align_hint"
                android:fontFamily="@font/cairo"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/scannerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scanner_ready"
                style="@style/TextSection"/>
            <TextView
                android:id="@+id/scannerCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/TextLabel"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/scannerRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                style="@style/TextMono"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false">
                <EditText
                    android:id="@+id/scannerManualInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/scanner_manual_hint"
                    android:singleLine="true"
                    android:maxLength="64"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:textDirection="ltr"
                    android:autofillHints=""
                    android:importantForAutofill="no"/>
                <Button
                    android:id="@+id/btnScannerManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scanner_manual_send"
                    android:layout_marginStart="8dp"
                    style="@style/BtnSecondary"/>
            </LinearLayout>
            <TextView
                android:id="@+id/scannerFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/TextLabel"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
