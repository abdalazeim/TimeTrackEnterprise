<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <ImageButton
            android:id="@+id/btnSetupBack"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_muted"
            android:contentDescription="@string/back"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scanner_setup_title"
                android:fontFamily="@font/cairo"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/scanner_setup_subtitle"
                android:fontFamily="@font/cairo"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scanner_setup_help"
                    style="@style/TextBody"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/scanner_setup_server"
                    style="@style/TextLabel"/>
                <EditText
                    android:id="@+id/setupServerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/companion_server_hint"
                    android:maxLength="200"
                    android:inputType="textUri"
                    android:textDirection="ltr"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/companion_passcode"
                    style="@style/TextLabel"/>
                <EditText
                    android:textSize="18sp"
                    android:id="@+id/setupPasscodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/companion_passcode_hint_input"
                    android:maxLength="8"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:textDirection="ltr"
                    android:letterSpacing="0.2"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_faint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/companion_passcode_help"
                    style="@style/TextBody"/>
                <Button
                    android:id="@+id/btnSetupConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/scanner_setup_connect"
                    style="@style/BtnPrimary"/>
                <TextView
                    android:textColor="@color/text_muted"
                    android:id="@+id/setupStatus"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    style="@style/TextBody"/>
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:id="@+id/setupPairCode"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/cairo"
                    android:letterSpacing="0.3"/>
                <Button
                    android:id="@+id/btnSetupReset"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/scanner_setup_reset"
                    style="@style/BtnSecondary"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/text_faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/scanner_setup_note"
                style="@style/TextBody"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
