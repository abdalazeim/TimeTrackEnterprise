    <string name="about">About</string>
    <string name="about_app_body">One app that combines a local SMS gateway with a full companion dashboard. It sends parent messages through the phone SIM card and shows attendance, absences, students, staff and reports from the school computer over the same Wi-Fi network. No cloud account or internet connection is required.</string>
    <string name="about_app_title">About the gateway</string>
    <string name="about_author_title">Developer</string>
    <string name="about_dedication_note">May God accept it, have mercy on him, and grant him paradise.</string>
    <string name="about_dedication_text">A continuous charity in memory of my late father, Bouzouira Kada.</string>
    <string name="about_dedication_title">Dedication</string>
    <string name="about_info_title">App information</string>
    <string name="about_license">Original software developed specifically for the Smart Attendance system.</string>
    <string name="about_privacy_body">The app collects no data and sends nothing to the internet. It receives requests from the attendance computer on the local network only and sends the text through the phone’s SIM card. A copy of sent messages remains in the system Messages app.</string>
